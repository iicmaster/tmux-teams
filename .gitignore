# BMAD project scaffold — not part of the plugin
_bmad/
_bmad-output/
.remember/
.agents/
.claude/
node_modules/
CLAUDE.local.md

# browser scratch from screenshot verification
.playwright-mcp/

# worker outboxes carry raw command output — never commit them
.mailbox-out/

# `.tmux-teams/` is the repo's own runtime state — published pages, dispatch
# records, KMS events, liveness. It is NOT listed here because it ignores itself
# through `.tmux-teams/.gitignore`, which is invisible to anyone reading this
# file and concluding it is unignored. Said here so the conclusion is not drawn.

# rendered pages from a smoke/verification run
output/

# `/docs/` at the ROOT is machine-local: artifact-sftp's read-back mirror of
# whatever has been published, plus `roadmap.html` which `roadmap-render.mjs`
# regenerates from ROADMAP.md. Leading slash on purpose —
# `plugins/tmux-teams/docs/adr/` is tracked and must stay that way.
/docs/
